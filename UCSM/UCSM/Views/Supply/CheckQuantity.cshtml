@{
    ViewData["Title"] = "Quantity Classification";
}
<h1 class="h2 fw-bold">Quantity classification</h1>
<div class="card border-0 shadow-sm mt-3" style="max-width: 520px;">
    <div class="card-body p-4">
        <p class="text-secondary mb-1">Requested quantity</p>
        <div class="display-6 fw-semibold">@ViewBag.Quantity</div>

        <div class="alert alert-info mt-3 mb-0" role="status">
            Order size: <strong>@ViewBag.Classification</strong>
        </div>
    </div>
</div>
