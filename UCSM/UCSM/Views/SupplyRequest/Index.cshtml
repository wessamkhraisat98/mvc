@{
    ViewData["Title"] = "Create Supply Request";
    var draftItems = ViewBag.DraftItems as List<UCSM.Controllers.SupplyRequestController.SupplyRequestItem>;
    string preferredPriority = ViewBag.PreferredPriority as string ?? "Normal";
}

<h1 class="h2 fw-bold">Create a supply request</h1>
<p class="text-secondary mb-4">Add one or more products to your request.</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success" role="status">@TempData["Message"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
}

@if (ViewBag.PreferenceMessage != null)
{
    <div class="alert alert-info" role="status">@ViewBag.PreferenceMessage</div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Add a product</h2>

                <form asp-controller="SupplyRequest" asp-action="AddItem" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="productName" class="form-label">Product name</label>
                        <select id="productName" name="productName" class="form-select" required>
                            <option value="">Choose a product</option>
                            @foreach (string product in ViewBag.Products)
                            {
                                <option value="@product">@product</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="category" class="form-label">Category</label>
                        <select id="category" name="category" class="form-select" required>
                            <option value="">Choose a category</option>
                            <option>Drinks</option>
                            <option>Food</option>
                            <option>Snacks</option>
                            <option>Hot Drinks</option>
                            <option>Cold Drinks</option>
                        </select>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="quantity" class="form-label">Quantity</label>
                            <input id="quantity" name="quantity" type="number" min="1" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label for="unitPrice" class="form-label">Unit price (JD)</label>
                            <input id="unitPrice" name="unitPrice" type="number" min="0.01" step="0.01" class="form-control" required />
                        </div>
                    </div>

                    <div class="mt-3 mb-4">
                        <label for="priority" class="form-label">Priority</label>
                        <select id="priority" name="priority" class="form-select" required>
                            <option value="Normal" selected="@(preferredPriority == "Normal")">Normal</option>
                            <option value="Urgent" selected="@(preferredPriority == "Urgent")">Urgent</option>
                            <option value="Emergency" selected="@(preferredPriority == "Emergency")">Emergency</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success">Add product to request</button>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body p-4">
                <h2 class="h5">Remember my priority</h2>
                <p class="text-secondary">Your preference will be saved for seven days.</p>
                <form asp-controller="SupplyRequest" asp-action="SavePreference" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <select name="priority" class="form-select" aria-label="Preferred priority">
                        <option value="Normal" selected="@(preferredPriority == "Normal")">Normal</option>
                        <option value="Urgent" selected="@(preferredPriority == "Urgent")">Urgent</option>
                        <option value="Emergency" selected="@(preferredPriority == "Emergency")">Emergency</option>
                    </select>
                    <button type="submit" class="btn btn-outline-success text-nowrap">Save preference</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5">Current draft</h2>

                @if (draftItems == null || draftItems.Count == 0)
                {
                    <p class="text-secondary mb-0">No products added yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var item in draftItems)
                        {
                            <li class="list-group-item px-0">
                                <div class="fw-semibold">@item.ProductName</div>
                                <div class="small text-secondary">
                                    @item.Quantity × @item.UnitPrice.ToString("0.00") JD
                                    · @item.Priority
                                </div>
                                <div class="small">Item total: @item.TotalCost.ToString("0.00") JD</div>
                            </li>
                        }
                    </ul>

                    <div class="d-grid gap-2">
                        <a class="btn btn-success" asp-controller="SupplyRequest" asp-action="Review">Review request</a>
                        <form asp-controller="SupplyRequest" asp-action="ClearDraft" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100">Clear draft</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
