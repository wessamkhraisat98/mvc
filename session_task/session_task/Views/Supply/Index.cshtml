
@using session_task.Models

@{
    ViewData["Title"] = "Create Supply Request";

    List<Category> categories = ViewBag.Categories;
    List<Supplier> suppliers = ViewBag.Suppliers;
    List<Offer> offers = ViewBag.Offers;
}

<div class="container mt-5">

    <div class="text-center mb-5">
        <h1>Graduation Ceremony Supplies</h1>
        <p class="text-muted">
            Select one offer from each category.
        </p>
    </div>

    <form action="@Url.Action("Save", "Supply")" method="post">

        @Html.AntiForgeryToken()

        @foreach (var category in categories)
        {
            <div class="card shadow-sm mb-4">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@category.Name</h4>
                </div>

                <div class="card-body">

                    <div class="row g-3">

                        @foreach (var supplier in suppliers.Where(
                            s => s.CategoryId == category.Id))
                        {
                            var offer = offers.FirstOrDefault(
                                o => o.SupplierId == supplier.Id);

                            if (offer != null)
                            {
                                <div class="col-md-4">

                                    <div class="card h-100">

                                        <div class="card-body">

                                            <h5 class="card-title">
                                                @supplier.Name
                                            </h5>

                                            <p>
                                                <strong>Offer:</strong>
                                                @offer.Name
                                            </p>

                                            <p>
                                                <strong>Quantity:</strong>
                                                @offer.Quantity
                                            </p>

                                            <p>
                                                <strong>Unit Price:</strong>
                                                @offer.UnitPrice.ToString("0.00") JD
                                            </p>

                                            <div class="form-check">

                                                <input
                                                    class="form-check-input"
                                                    type="radio"
                                                    name="selectedOffers[@category.Id]"
                                                    value="@offer.Id"
                                                    id="offer-@offer.Id"
                                                    required />

                                                <label
                                                    class="form-check-label"
                                                    for="offer-@offer.Id">
                                                    Select this offer
                                                </label>

                                            </div>

                                        </div>

                                    </div>

                                </div>
                            }
                        }

                    </div>

                </div>

            </div>
        }

        <div class="text-center mb-5">

            <button type="submit"
                    class="btn btn-success btn-lg px-5">
                Save Selected Offers
            </button>

        </div>

    </form>

</div>
