<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - University Cafeteria Inventory and Purchase Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <header class="border-bottom">
        <nav class="container py-3 d-flex flex-wrap gap-3" aria-label="Main navigation">
            <a href="@Url.Action("Index", "Categories")">Categories</a>
            <a href="@Url.Action("Index", "Suppliers")">Suppliers</a>
            <a href="@Url.Action("Index", "Products")">Products</a>
            <a href="@Url.Action("Index", "PurchaseOrders")">Purchase Orders</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="btn btn-sm btn-outline-secondary">Sign out</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Sign in</a>
            }
        </nav>
    </header>
    <main class="container py-4">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
